The Vision model should ONLY return JSON.

Example

```json
{
  "hand": "right",
  "confidence": 0.94,
  "imageQuality": "good",

  "majorLines": {
    "lifeLine": {
      "length": "long",
      "depth": "deep",
      "curve": "moderate"
    },
    "headLine": {
      "length": "medium",
      "depth": "clear",
      "curve": "straight"
    },
    "heartLine": {
      "length": "long",
      "depth": "clear",
      "curve": "curved"
    },
    "fateLine": {
      "visibility": "moderate"
    }
  },

  "mounts": {
    "venus": "prominent",
    "jupiter": "average",
    "saturn": "strong",
    "apollo": "moderate",
