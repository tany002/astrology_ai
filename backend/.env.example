# Server
PORT=5000
NODE_ENV=production

# MongoDB — the backend accepts either variable name (MONGODB_URI takes precedence)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/astrologer-ai?retryWrites=true&w=majority
# MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/astrologer-ai?retryWrites=true&w=majority

# Razorpay (required for payment flow)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL — REQUIRED for CORS in production. Requests from other origins will be rejected.
FRONTEND_URL=https://your-vercel-app.vercel.app

# Launch offer price in paise (₹5 = 500 paise). Defaults to 500 if not set.
LAUNCH_PRICE_PAISE=500

# ── Not required for MVP ──────────────────────────────────────────────────────
# Cloudinary (only needed when image upload pipeline is re-enabled)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# OpenAI (only needed when AI report pipeline is re-enabled)
# OPENAI_API_KEY=sk-...

# Full AI pipeline pricing in paise — ₹299 = 29900 (only needed for full pipeline)
# PRICE_PAISE=29900
